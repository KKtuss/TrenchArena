{
  "name": "@pokearena/workspace",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "sync:copies": "powershell -ExecutionPolicy Bypass -File scripts/sync-workspace-copies.ps1",
    "dev:api": "pnpm --filter @pokearena/api dev",
    "dev:web": "pnpm --filter @pokearena/web dev",
    "solana:client": "pnpm --filter @pokearena/solana-client build",
    "solana:test": "pnpm --filter @pokearena/solana-client test"
  }
}
