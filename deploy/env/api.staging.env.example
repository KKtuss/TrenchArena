# PokeArena isolated Mainnet staging configuration.
# This file contains placeholders only. Never point it at production secrets.

NODE_ENV=production
POKEARENA_STAGING=true
POKEARENA_ECONOMICS=postgres
POKEARENA_CHAIN_ECONOMY=true
POKEARENA_BIND_HOST=127.0.0.1
PORT=3000

POKEARENA_DATABASE_URL=postgres://pokearena_staging:REPLACE_WITH_STAGING_PASSWORD@127.0.0.1:5432/pokearena_staging
POKEARENA_SOLANA_CLUSTER=mainnet-beta
POKEARENA_SOLANA_RPC=https://REPLACE_WITH_HELIUS_FREE_STAGING_RPC
POKEARENA_SOLANA_COMMITMENT=confirmed

# Fresh staging signers. Generate these later. Do not reuse retired or production keys.
POKEARENA_PROGRAM_ID=REPLACE_WITH_NEW_STAGING_PROGRAM_ID
POKEARENA_PROGRAM_KEYPAIR=REPLACE_WITH_PATH_TO_NEW_STAGING_PROGRAM_KEYPAIR
POKEARENA_DEPLOYER=REPLACE_WITH_NEW_STAGING_DEPLOYER_PUBKEY
POKEARENA_DEPLOY_KEYPAIR=REPLACE_WITH_PATH_TO_NEW_STAGING_DEPLOYER_KEYPAIR
POKEARENA_AUTHORITY=REPLACE_WITH_NEW_STAGING_CONFIG_AUTHORITY
POKEARENA_AUTHORITY_KEYPAIR=REPLACE_WITH_PATH_TO_NEW_STAGING_CONFIG_AUTHORITY_KEYPAIR
POKEARENA_KEEPER=REPLACE_WITH_NEW_STAGING_KEEPER
POKEARENA_KEEPER_KEYPAIR=REPLACE_WITH_PATH_TO_NEW_STAGING_KEEPER_KEYPAIR
# POKE stays unset until a new Token-2022 mint is created. Do not use a production mint.
POKEARENA_POKE_MINT=unset
# Shared Pump CARDS prize mint. This is not a staging signer.
POKEARENA_CARDS_MINT=CARDSccUMFKoPRZxt5vt3ksUbxEFEcnZ3H2pd3dKxYjp
POKEARENA_TOURNAMENT_PRIZE_CARDS_RAW=100000000
POKEARENA_FEE_VAULT=REPLACE_WITH_STAGING_FEE_VAULT
POKEARENA_TREASURY_VAULT=REPLACE_WITH_STAGING_TREASURY_VAULT
POKEARENA_OPERATOR_VAULT=REPLACE_WITH_STAGING_OPERATOR_VAULT
POKEARENA_QUOTE_AUTHORITY=REPLACE_WITH_STAGING_QUOTE_AUTHORITY

POKEARENA_BUYBACK_BPS=0
POKEARENA_MIN_BUYBACK_LAMPORTS=50000000
