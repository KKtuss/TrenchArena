# PokeArena Web — BUILD-TIME variables for a production Next.js bundle
#
# These must be in the environment of the `pnpm --filter @pokearena/web build`
# process. They are compiled into apps/web/.next. Changing them later in
# /etc/pokearena/web.env does NOT update browsers that load an existing bundle.
#
# Example (replace the hostname placeholder):
#
#   export NEXT_PUBLIC_WS_URL=wss://pokearena.example/ws
#   pnpm --filter @pokearena/web build
#
# Do not copy apps/web/.env.development into a production build.
# Do not set NEXT_PUBLIC_POKEARENA_ALLOW_DEMO_AUTH.

NEXT_PUBLIC_WS_URL=wss://pokearena.example/ws
NEXT_PUBLIC_SOLANA_RPC=https://your-production-solana-rpc.example
