# Local validator + chain economy (source after scripts/solana/bootstrap-local.sh)
NODE_ENV=development
POKEARENA_ECONOMICS=postgres
POKEARENA_DATABASE_URL=postgres://pokearena:pokearena@127.0.0.1:5432/pokearena
POKEARENA_ALLOW_DEMO_AUTH=true
POKEARENA_BIND_HOST=127.0.0.1
PORT=3000

POKEARENA_CHAIN_ECONOMY=true
POKEARENA_SOLANA_CLUSTER=localnet
POKEARENA_SOLANA_RPC=http://127.0.0.1:8899
POKEARENA_SOLANA_COMMITMENT=confirmed

# Filled by bootstrap-local.sh / init-config.mjs into scripts/solana/.local.env — copy those values here.
POKEARENA_PROGRAM_ID=41GGgA4QzQfWxqUmqkitkhhcyrfMuVxq7Gr2FDwdbu4W
POKEARENA_POKE_MINT=
# Fee/treasury/operator are program PDAs — blank derives from PROGRAM_ID.
POKEARENA_FEE_VAULT=
POKEARENA_TREASURY_VAULT=
POKEARENA_OPERATOR_VAULT=
POKEARENA_QUOTE_AUTHORITY=
POKEARENA_KEEPER=
POKEARENA_AUTHORITY=
# Server-side keeper signer used only for verified settlement/refund/burn/prize actions.
POKEARENA_KEEPER_KEYPAIR=
POKEARENA_BUYBACK_BPS=2500
POKEARENA_MIN_BUYBACK_LAMPORTS=50000000
POKEARENA_POKE_PRICE_MICRO_USD=400000
POKEARENA_POKE_DECIMALS=6
POKEARENA_POKE_PRICE_CONFIDENCE_BPS=0
