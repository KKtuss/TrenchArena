# PokeArena Web — production systemd EnvironmentFile (runtime only)
#
# Install:
#   sudo mkdir -p /etc/pokearena
#   sudo cp deploy/env/web.env.example /etc/pokearena/web.env
#   sudo chown root:pokearena /etc/pokearena/web.env
#   sudo chmod 640 /etc/pokearena/web.env
#
# This file is loaded when pokearena-web.service starts. It does not rebuild
# Next.js. NEXT_PUBLIC_* variables are inlined at `pnpm --filter @pokearena/web
# build` time. See deploy/env/web.build.env.example.
#
# The unit also passes `next start -p 3001 -H 127.0.0.1` so this process is
# loopback-only even if HOSTNAME/PORT are omitted.

NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3001
