# PokeArena API — production EnvironmentFile example
#
# Install:
#   sudo mkdir -p /etc/pokearena
#   sudo cp deploy/env/api.env.example /etc/pokearena/api.env
#   sudo chown root:pokearena /etc/pokearena/api.env
#   sudo chmod 640 /etc/pokearena/api.env
#
# Then replace placeholders. Do not commit the real /etc/pokearena/api.env.
# systemd EnvironmentFile does not expand shell variables or quotes the way
# bash does; keep values unquoted unless they contain spaces.

NODE_ENV=production
POKEARENA_ECONOMICS=postgres
POKEARENA_BIND_HOST=127.0.0.1
PORT=3000
POKEARENA_TRUST_PROXY=true

# Public browser Origin (scheme + host, no path). Replace the placeholder.
POKEARENA_ALLOWED_ORIGINS=https://pokearena.example

# PostgreSQL on loopback/private only. Percent-encode special characters in
# the password. Never point this at a publicly reachable Postgres.
POKEARENA_DATABASE_URL=postgres://pokearena:REPLACE_WITH_PASSWORD@127.0.0.1:5432/pokearena

# Connection and payload limits (repository defaults shown).
POKEARENA_MAX_WS_CONNECTIONS=512
POKEARENA_MAX_WS_CONNECTIONS_PER_IP=16
POKEARENA_MAX_WS_PAYLOAD=32768

# Rate limits (per window).
POKEARENA_RATE_WINDOW_MS=60000
POKEARENA_RATE_AUTH_CHALLENGE=10
POKEARENA_RATE_CASUAL_CREATE=20
POKEARENA_RATE_TOURNAMENT_CREATE=10
POKEARENA_RATE_TEAM_SEARCH=60
POKEARENA_RATE_MATCH_CHOICE=120

# Auth challenge lifetime.
POKEARENA_AUTH_CHALLENGE_TTL_MS=300000
POKEARENA_AUTH_CHALLENGE_CLEANUP_MS=15000

# Must stay unset/false in production:
# POKEARENA_ALLOW_DEMO_AUTH
# POKEARENA_ECONOMICS=memory   # production refuses memory economics and will not listen
