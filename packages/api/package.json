{
  "name": "@pokearena/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/src/server.js",
  "types": "dist/src/server.d.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "node ./scripts/dev-server.js",
    "test": "npm run build && node --test --test-force-exit dist/test/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pokearena/battle-engine": "workspace:*",
    "@pokearena/db": "workspace:*",
    "@pokearena/solana-client": "workspace:*",
    "@pokearena/tournament": "workspace:*",
    "@solana/web3.js": "1.98.4",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  }
}
