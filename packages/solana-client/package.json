{
  "name": "@pokearena/solana-client",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./poke-units": {
      "types": "./dist/src/poke-units.d.ts",
      "default": "./dist/src/poke-units.js"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "test:program": "npm run test"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "litesvm": "^0.3.3",
    "litesvm-linux-x64-gnu": "^0.3.3",
    "typescript": "5.9.2"
  }
}
