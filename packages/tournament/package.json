{
  "name": "@pokearena/tournament",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./rotation": {
      "types": "./dist/src/rotation.d.ts",
      "import": "./dist/src/rotation.js",
      "require": "./dist/src/rotation.js",
      "default": "./dist/src/rotation.js"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pokearena/battle-engine": "workspace:*",
    "@pokearena/solana-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  }
}
